      "Location": {
        "Attribute": "data-qa",
        "Value": "vacancy-serp__vacancy-address"
      },
      "Company": {
        "Attribute": "data-qa",
        "Value": "vacancy-serp__vacancy-employer-text"
      },
      "Experience": {
        "Attribute": "data-qa",
        "Value": "vacancy-serp__vacancy-work-experience"
      }
    }
  ]
}